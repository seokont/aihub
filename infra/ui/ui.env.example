# MONI AI — LibreChat UI environment (task 1.4). TEMPLATE.
#
# Copy to `ui/.env` and replace every `change-me*` value:
#
#     Copy-Item infra/ui/ui.env.example ui/.env      # PowerShell
#
# Where this file sits, and why: it is NOT `ui/.env.example`. The upstream template is a
# 1000-line file of LibreChat's own options, and ours is the small subset this deployment
# uses. Keeping it here means `ui/` stays a pristine checkout of the pinned tag and the
# settings MONI actually sets are reviewable in one screen. The UI container reads it as
# its env_file, so the variables are LibreChat's own names, unchanged.

# --- Application -------------------------------------------------------------
APP_TITLE=MONI AI
# The container listens on 3080; nginx publishes it on 127.0.0.1 (see compose).
HOST=0.0.0.0
PORT=3080
NODE_ENV=production
# Dev-only stack. Any other value here should come with TLS and secure cookies.
DOMAIN_CLIENT=http://127.0.0.1
DOMAIN_SERVER=http://127.0.0.1

# --- Storage -----------------------------------------------------------------
# Container-to-container. MongoDB publishes NO host port (§3.1): nothing but the UI
# should reach the conversation store.
#
# The credentials are part of the URI and MUST match UI_MONGO_PASSWORD in the root .env
# (which the compose file uses to create the root user). Without them MongoDB answers
# "Command find requires authentication" and LibreChat exits at startup — an easy mistake,
# because the connection itself succeeds and only the first query fails.
# scripts/gen_ui_secrets.py substitutes the real password when it writes ui/.env.
MONGO_URI=mongodb://moni:change-me-must-match-UI_MONGO_PASSWORD@ui-mongodb:27017/LibreChat?authSource=admin
MEILI_HOST=http://ui-meilisearch:7700
MEILI_MASTER_KEY=change-me-generate-with-openssl-rand-hex-32
MEILI_NO_ANALYTICS=true

# --- Credential encryption and sessions --------------------------------------
# LibreChat ships working-looking DEFAULTS for all four of these. Leaving them is a
# security defect, not a shortcut: a published key means every stored credential and every
# session cookie is forgeable by anyone who has read the upstream repository.
#
#   CREDS_KEY  : 32 bytes hex (64 chars)   CREDS_IV : 16 bytes hex (32 chars)
#   openssl rand -hex 32   /   openssl rand -hex 16
CREDS_KEY=change-me-32-bytes-hex-64-chars
CREDS_IV=change-me-16-bytes-hex-32-chars
JWT_SECRET=change-me-32-bytes-hex-64-chars
JWT_REFRESH_SECRET=change-me-32-bytes-hex-64-chars

# --- Local authentication is DISABLED ---------------------------------------
# Accounts come from Keycloak. An account created in LibreChat would have no Keycloak
# subject, so it could not be mapped to Odoo credentials (§3.2) and every request would
# fail closed — better to refuse sign-up than to allow a dead-end account.
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=false
ALLOW_SOCIAL_LOGIN=true

# --- Keycloak OIDC -----------------------------------------------------------
# `moni-ui-web` is the CONFIDENTIAL client (standard flow + secret). `moni-ui` is the
# public PKCE client the integration tests use for the password grant; they are separate
# clients on purpose (see infra/keycloak/generate_realm_export.py).
OPENID_CLIENT_ID=moni-ui-web
OPENID_CLIENT_SECRET=change-me-must-match-MONI_UI_WEB_CLIENT_SECRET
# The PUBLIC, browser-facing issuer — this is the IDENTITY, and it must match the `iss`
# claim Keycloak stamps into its responses. Keycloak advertises this address because
# KC_HOSTNAME is set to the published loopback port, so it is what the browser is sent to
# and what openid-client must expect.
#
# Do NOT change this to a compose service name "so the container can reach it": a service
# name never appears in a token, so the expected issuer would match nothing and the
# authorization response would be rejected.
OPENID_ISSUER=http://127.0.0.1:8081/realms/moni

# Where to actually FETCH the OIDC endpoints from — the TRANSPORT, not the identity.
#
# The UI container cannot reach 127.0.0.1:8081 (inside a container that is the container
# itself), so fork entry 0002 rewrites the origin of outgoing OIDC requests from
# OPENID_ISSUER to this address, and leaves the responses untouched. The discovery document
# therefore still advertises the public `issuer` and `authorization_endpoint`.
#
# Dev only, and only effective while ALLOW_INSECURE_OIDC and MONI_ENV=dev are both set.
# Leave it empty in any deployment that can resolve the public issuer directly.
OPENID_INTERNAL_ISSUER=http://keycloak:8080/realms/moni
OPENID_SESSION_SECRET=change-me-32-bytes-hex-64-chars
OPENID_SCOPE=openid profile email
OPENID_CALLBACK_URL=/oauth/openid/callback
# Log out at Keycloak too, so the SSO session ends rather than being silently re-used.
OPENID_USE_END_SESSION_ENDPOINT=true
OPENID_BUTTON_LABEL=Увійти через MONI AI
OPENID_AUTO_REDIRECT=false

# --- Plain-HTTP OIDC (DEV ONLY) — see docs/FORK_CHANGES.md entry 0002 --------
# openid-client's oauth4webapi layer refuses a non-HTTPS OIDC issuer unless the caller
# opts in, and upstream LibreChat never opts in: with an http:// issuer the OpenID
# strategy does not register and login is impossible. The dev stack's Keycloak is plain
# HTTP on the loopback, so fork entry 0002 passes `allowInsecureRequests`.
#
# That patch is DOUBLE-GATED — ALLOW_INSECURE_OIDC must be enabled AND MONI_ENV must be
# `dev`. Removing MONI_ENV=dev disables the relaxation even if this stays true, which is
# the point: an http:// OIDC issuer in production is a real vulnerability.
#
# DELETE BOTH LINES when Keycloak is served over TLS. They are the only reason this file
# differs from an upstream-safe configuration.
MONI_ENV=dev
ALLOW_INSECURE_OIDC=true
# LibreChat reads roles from the access token by default; Keycloak puts realm roles under
# realm_access.roles. Not used for authorization here (the gateway does that), but it lets
# LibreChat's own admin role sync work when it is switched on.
OPENID_REQUIRED_ROLE_PARAMETER_PATH=realm_access.roles

# THE setting that makes per-user token forwarding work. Without it there is no stored
# federated access token and `{{LIBRECHAT_OPENID_ACCESS_TOKEN}}` cannot resolve — the
# Authorization header is then omitted and every request fails closed.
#
# This is a LibreChat-specific switch and it must stay a placeholder in the template: it
# encodes "the user's own token, not a shared one" (§3.2), so setting it to false in a
# deployed environment is a security regression, not a preference.
OPENID_REUSE_TOKENS=true
# Keep the forwarded token fresh: Keycloak's access tokens are short-lived, and a stale
# token would be rejected by the gateway mid-conversation. This is LibreChat's own
# refresh window (15 minutes), not the same as the gateway's run rate limit.
OPENID_REUSE_MAX_SESSION_AGE_MS=900000

# Signing algorithms accepted for a Keycloak bearer token, space- or comma-separated.
#
# Needed because `jsonwebtoken` defaults to ['HS256','HS384','HS512'] when the caller does
# not state the algorithm, so an RS256 Keycloak token was rejected with
# {"message":"invalid algorithm"} on every /api/* request once OPENID_REUSE_TOKENS was on
# (fork entry 0003). Keycloak signs RS256, which is also the code default, so this variable
# exists only to make the accepted set explicit and adjustable for another IdP.
OPENID_JWT_ALGORITHMS=RS256

# Accepted `aud` for a Keycloak bearer token, on top of OPENID_CLIENT_ID.
#
# REQUIRED here, and the reason is the single-entry rule rather than an OIDC preference:
# the realm's `moni-gateway-audience` mapper puts `aud: moni-gateway` into the access token,
# because the GATEWAY rejects any token whose audience is not `moni-gateway`
# (moni_gateway.security). So the token LibreChat receives has `aud=moni-gateway`, while
# LibreChat's own audience check expects the client id (`moni-ui-web`) — they cannot both be
# satisfied by the token, and the gateway's requirement is the one that cannot move.
#
# LibreChat validates against OPENID_CLIENT_ID + OPENID_AUDIENCE, so listing the gateway
# audience here is what makes the same token acceptable to both services. Without it the
# openidJwt strategy fails with "Audience doesn't match" and the request falls through to
# the HS256 `jwt` strategy, which then reports the confusing "invalid algorithm".
OPENID_AUDIENCE=moni-gateway

# --- Phase 1: no external providers, no web search, no code execution --------
# Every one of these would let the UI reach a model without passing through the gateway,
# which would break the single-entry rule (§3.1) and the audit trail (§3.8).
ALLOW_SHARED_LINKS=false
ALLOW_SHARED_LINKS_PUBLIC=false

# --- MONI ---------------------------------------------------------------------
# Not a real credential: the gateway takes identity from the Authorization header, and
# this value only satisfies LibreChat's required `apiKey` field for a custom endpoint.
MONI_UPSTREAM_KEY=moni-internal-placeholder
